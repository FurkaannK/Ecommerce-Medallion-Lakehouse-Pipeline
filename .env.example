# MinIO Configuration
MINIO_ENDPOINT=http://localhost:9000
MINIO_DOCKER_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
AWS_REGION=us-east-1

# Postgres / Airflow Metadata DB Credentials
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=airflow

# Airflow Admin User
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=your_admin_password

# Medallion Lakehouse Buckets
BRONZE_BUCKET=ecommerce-bronze
SILVER_BUCKET=ecommerce-silver
GOLD_BUCKET=ecommerce-gold
